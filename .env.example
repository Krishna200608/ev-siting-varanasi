# Environment Variables Template
# Copy this file to .env and populate with your actual keys if required.

# OpenChargeMap API Key (Optional / if pulling live data via API)
OPENCHARGEMAP_API_KEY=

# Google Places API Key (Optional / if extracting POIs via Google API rather than OSM)
GOOGLE_PLACES_API_KEY=

# Default random seed for reproducibility
RANDOM_SEED=42
